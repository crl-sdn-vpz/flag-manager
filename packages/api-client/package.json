{
  "name": "api-client",
  "private": true,
  "type": "module",
  "description": "Generated from the API's OpenAPI document by `just gen-client`. Never edit by hand.",
  "exports": {
    ".": "./src/generated/index.ts",
    "./client": "./src/generated/client.gen.ts",
    "./query": "./src/generated/@tanstack/react-query.gen.ts"
  },
  "scripts": {
    "generate": "openapi-ts --no-log-file --silent"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tanstack/react-query": "5.104.2",
    "typescript": "6.0.3"
  }
}
